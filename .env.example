HTTP_ADDR=:8080
DB_DRIVER=postgres
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
# Prefixo do campo "type" no Problem Details. Vazio => about:blank
PROBLEM_TYPE_BASE=

# Keycloak (realm "app" do docker-compose)
OIDC_ISSUER_URL=http://localhost:8180/realms/app
OIDC_AUDIENCE=app-api
# Só quando a API alcança o Keycloak por outro endereço (ex.: dentro do compose)
OIDC_DISCOVERY_URL=
